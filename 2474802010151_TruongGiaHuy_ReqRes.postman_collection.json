        {
          "name": "reate User (Tích hợp Data-Driven Testing)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\n    pm.response.to.have.status(201);\n});\n\npm.test(\"Check name and job in response\", function () {\n    var jsonData = pm.response.json();\n    // Kiểm tra trực tiếp với chuỗi bạn đã nhập ở Body\n    pm.expect(jsonData.name).to.eql(\"An Nguyen\");\n    pm.expect(jsonData.job).to.eql(\"QA Lead\");\n});\n\npm.test(\"Extract and set userId\", function () {\n    var jsonData = pm.response.json();\n    pm.environment.set(\"userId\", jsonData.id);\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "free_user_3L2pBRzwGupfjXdKNyMdrz6QsBU"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n \"name\": \"An Nguyen\",\r\n \"job\": \"QA Lead\"\r\n}\r\n",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "response": []
        },
        {
